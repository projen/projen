// Every GitHub Action used by projen, mapped to the version line it follows.
//
// This is the single source of truth. Editing an entry here and running
// projen regenerates src/github/actions.const.ts, which is what the code
// actually references.
//
// Fields per action:
// - "major":       The approved version line (e.g. "v7"). Changing this requires
//                  human review. Used directly as a floating tag unless a pin is set.
// - "pin":         Optional concrete ref (commit SHA or immutable tag) within the
//                  major line. Written by the update script, never by hand.
// - "version":     The human-readable version the pin corresponds to. Required
//                  when the pin is not self-describing (i.e. a SHA).
// - "isImmutable": Whether the pin is an immutable tag: a release GitHub
//                  reports as immutable, meaning the tag cannot be repointed and
//                  is as strong a guarantee as a commit SHA. Set from the GitHub
//                  API, not by hand.
// - "cooldownDays": Optional per-action override for the global cooldown.
{
  // Days a release must be public before the update script adopts it.
  "cooldownDays": 7,
  "actions": {
    "actions/checkout": {
      "major": "v7",
      "pin": "3d3c42e5aac5ba805825da76410c181273ba90b1",
      "version": "v7.0.1"
    },
    "actions/create-github-app-token": {
      "major": "v3",
      "pin": "v3.2.0",
      "isImmutable": true
    },
    "actions/dependency-review-action": {
      "major": "v5",
      "pin": "a1d282b36b6f3519aa1f3fc636f609c47dddb294",
      "version": "v5.0.0"
    },
    "actions/download-artifact": {
      "major": "v8",
      "pin": "3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
      "version": "v8.0.1"
    },
    "actions/github-script": {
      "major": "v9",
      "pin": "3a2844b7e9c422d3c10d287c895573f7108da1b3",
      "version": "v9.0.0"
    },
    "actions/setup-dotnet": {
      "major": "v6",
      "pin": "v6.0.0",
      "isImmutable": true
    },
    "actions/setup-go": {
      "major": "v7",
      "pin": "v7.0.0",
      "isImmutable": true
    },
    "actions/setup-java": {
      "major": "v6",
      "pin": "v6.0.0",
      "isImmutable": true
    },
    "actions/setup-node": {
      "major": "v7",
      "pin": "v7.0.0",
      "isImmutable": true
    },
    "actions/setup-python": {
      "major": "v7",
      "pin": "v7.0.0",
      "isImmutable": true
    },
    "actions/stale": {
      "major": "v11",
      "pin": "v11.0.0",
      "isImmutable": true
    },
    "actions/upload-artifact": {
      "major": "v7",
      "pin": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
      "version": "v7.0.1"
    },
    "amannn/action-semantic-pull-request": {
      "major": "v6",
      "pin": "48f256284bd46cdaab1048c3721360e808335d50",
      "version": "v6.1.1"
    },
    "aws-actions/configure-aws-credentials": {
      "major": "v6",
      "pin": "v6.2.3",
      "isImmutable": true
    },
    "codecov/codecov-action": {
      "major": "v7",
      "pin": "v7.0.0",
      "isImmutable": true
    },
    "oven-sh/setup-bun": {
      "major": "v2",
      "pin": "0c5077e51419868618aeaa5fe8019c62421857d6",
      "version": "v2.2.0"
    },
    "peter-evans/create-pull-request": {
      "major": "v8",
      "pin": "v8.1.1",
      "isImmutable": true
    },
    "pnpm/action-setup": {
      "major": "v6",
      "pin": "v6.0.10",
      "isImmutable": true
    },
    "sqren/backport-github-action": {
      "major": "v12",
